{
  "name": "discord-migrate-bot",
  "version": "0.0.1",
  "description": "",
  "main": "src/DiscordBot.ts",
  "type": "module",
  "scripts": {
    "build": "tsup src --config tsup.config.ts",
    "coverage": "open ./coverage/lcov-report/index.html",
    "dev:discord": "nodemon --config nodemon.discord.json",
    "git:update": "git add -u",
    "lint:all": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "lint:staged": "lint-staged",
    "lint": "eslint . --quiet",
    "precommit": "run-s lint:staged git:update",
    "prepare": "husky",
    "pretty:all": "pretty-quick",
    "pretty:staged": "pretty-quick --staged",
    "prettylint:all": "run-s pretty:all lint:all",
    "start:discord": "node -r dotenv/config build/DiscordBot.js",
    "studio": "prisma studio --browser none --url file:./dev.db"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11.8.0"
  },
  "engineStrict": true,
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@discordx/importer": "^1.3.3",
    "@prisma/adapter-better-sqlite3": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@types/lodash": "^4.17.23",
    "better-sqlite3": "^12.6.2",
    "discord-api-types": "^0.38.39",
    "discord.js": "^14.25.1",
    "discordx": "^11.13.3",
    "dotenv": "^17.3.1",
    "lodash": "^4.17.23",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "babel-jest": "^30.2.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-tsdoc": "^0.5.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "pretty-quick": "^4.2.2",
    "prisma": "^7.4.0",
    "ts-jest": "^29.4.6",
    "ts-jest-resolver": "^2.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.55.0"
  }
}
